INPUT:
language core;
extend with #references, #unit-type, #structural-subtyping, #top-type, #records, #let-bindings;

fn read_a(r : &{ a : Nat }) -> Nat {
  return (*r).a
}

fn main(n : Nat) -> Nat {
  return let r = new({ a = n }) in read_a(r)
}


